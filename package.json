{
  "name": "@amirjaz/persian-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Persian-first React components and utilities: RTL-correct inputs, a Jalali date picker, and validators for Iranian data.",
  "author": "Amirjaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amirjaz/persian-ui.git"
  },
  "keywords": [
    "persian",
    "farsi",
    "iran",
    "rtl",
    "bidi",
    "jalali",
    "shamsi",
    "date-picker",
    "national-id",
    "sheba",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build && pnpm check:dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jalaali-js": "^2.0.1",
    "tsup": "8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
