{
  "name": "@amirjaz/persian-ui",
  "version": "0.1.0",
  "description": "Persian-first React components and utilities: RTL-correct inputs, a Jalali date picker, and validators for Iranian data.",
  "license": "MIT",
  "author": "Amirjaz",
  "homepage": "https://github.com/Amirjaz/persian-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amirjaz/persian-ui.git"
  },
  "bugs": {
    "url": "https://github.com/Amirjaz/persian-ui/issues"
  },
  "keywords": [
    "persian",
    "farsi",
    "iran",
    "rtl",
    "bidi",
    "jalali",
    "shamsi",
    "date-picker",
    "national-id",
    "sheba",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.unlayered.css": "./dist/styles.unlayered.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "core"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.13.1",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build && pnpm check:dist && pnpm check:package",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints styles.css styles.unlayered.css",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jalaali-js": "^2.0.1",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  }
}
